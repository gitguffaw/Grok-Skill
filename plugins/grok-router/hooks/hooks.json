{
  "description": "When the host ends a turn, run Grok Router review --panel on a dirty git tree.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/stop-review-panel-hook.mjs\"",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
